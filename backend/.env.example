APP_ENV=dev

DATABASE_URL=postgresql://postgres:password@host:5432/postgres

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=profile-pictures
SUPABASE_MEDIA_BUCKET=post-media
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
# Required in production. Comma-separated frontend origins (no spaces), e.g. https://yourapp.vercel.app,https://pageshare.io
CORS_ORIGINS=
CRON_SECRET=YOUR_CRON_SECRET
GNEWS_API_KEY=YOUR_GNEWS_API_KEY

# Stripe billing (test mode keys for dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_ANALYST_MONTHLY=price_...
STRIPE_PRICE_ID_ANALYST_YEARLY=price_...
STRIPE_PRICE_ID_INVESTOR_MONTHLY=price_...
STRIPE_PRICE_ID_INVESTOR_YEARLY=price_...
STRIPE_CUSTOMER_PORTAL_RETURN_URL=http://localhost:3000/settings/billing
# Polygon prediction hash anchoring (optional). Relayer wallet pays gas.
# Deploy PredictionAnchor.sol from that wallet, then set the contract address.
# Do not use https://polygon-rpc.com — it currently returns HTTP 401.
POLYGON_RPC_URL=https://polygon.drpc.org
POLYGON_CHAIN_ID=137
POLYGON_RELAYER_PRIVATE_KEY=0x...
POLYGON_ANCHOR_CONTRACT_ADDRESS=0x...